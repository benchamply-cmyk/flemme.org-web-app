{
  "name": "@flemme/mobile",
  "version": "0.1.1",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test ../../packages/shared/tests/*.test.ts tests/*.cjs",
    "export:ios": "expo export --platform ios",
    "export:android": "expo export --platform android",
    "export:web": "expo export --platform web --output-dir dist-web"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.17",
    "expo": "58.0.20",
    "expo-crypto": "58.0.7",
    "expo-document-picker": "58.0.4",
    "expo-file-system": "58.0.12",
    "expo-secure-store": "58.0.2",
    "expo-status-bar": "58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
