# Absent : démonstration locale, données fictives, aucun échange entre appareils.
# Présents tous les deux : connexion aux comptes Supabase et marketplace partagée.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Jamais de service_role ou clé secrète dans une application mobile.
# Environnement des feature flags lus dans /admin › Fonctionnalités : local, beta, preprod ou prod.
# Absent : « local » en démonstration, « prod » (le plus prudent) en mode connecté. Les profils de eas.json le fixent.
EXPO_PUBLIC_FLEMME_ENV=preprod
