# Mode connecté (facultatif) : mêmes valeurs publiques que apps/mobile/.env, préfixe VITE_.
# Laisser vide pour la démo locale. Jamais de clé service_role ni sb_secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Paiement en ligne Stripe Connect : « oui » seulement quand paiement.sql et les fonctions Edge sont installés
# (voir docs/paiement-stripe.md). Vide = paiement direct déclaratif.
VITE_PAIEMENT_EN_LIGNE=
